# Copy to .env and fill in. .env is git-ignored. Plain text: keep this machine locked.

# --- Chase US (scraped through the debug Chrome from start-chrome.ps1) ---
# Comma-separated digital-account-identifier values (see Chase scraper notes)
CHASE_ACCOUNT_IDS=
CHASE_USERNAME=
CHASE_PASSWORD=

# --- Max (Israeli credit card) ---
MAX_USERNAME=
MAX_PASSWORD=

# --- One Zero (Israeli bank) ---
ONEZERO_EMAIL=
ONEZERO_PASSWORD=
# International format, e.g. +972501234567
ONEZERO_PHONE=
# Filled in automatically by: npm --prefix israel run onezero-setup
ONEZERO_OTP_TOKEN=

# How far back the Israeli scrapers look on each run (days). Max supports ~365.
ISRAEL_LOOKBACK_DAYS=365

# --- Pepper (Israeli bank, by Leumi; app-protocol via vendored fork) ---
PEPPER_PHONE=
PEPPER_PASSWORD=
# Filled in automatically by: npm --prefix israel run pepper-setup
PEPPER_OTP_TOKEN=

# --- Isracard (credit card; browser scraper) ---
ISRACARD_ID=
# The 6 digits Isracard asks for (last 6 of the card)
ISRACARD_CARD6=
ISRACARD_PASSWORD=
# Auto-filled by pepper-setup for unattended re-auth (no SMS). Do not edit by hand.
PEPPER_DEVICE_ID=
PEPPER_EC_KEY=
PEPPER_RSA_KEY=
